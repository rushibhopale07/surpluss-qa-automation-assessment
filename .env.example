# Copy this file to `.env` before you start. The defaults below match the
# Postgres container in docker-compose.yml, so for this exercise you should not
# need to change anything.

# Application
NEXTAUTH_URL=http://localhost:3001
APP_URL=http://localhost:3001

# Any string of 32+ characters works locally.
AUTH_SECRET=local-development-secret-do-not-use-in-production

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql://catalogue:catalogue@localhost:5544/catalogue
DIRECT_URL=postgresql://catalogue:catalogue@localhost:5544/catalogue

# ---------------------------------------------------------------------------
# Everything below is OPTIONAL and unset on purpose.
#
# Image uploads, email and WhatsApp notifications talk to external services.
# With these blank the app degrades gracefully: uploads return 503 and
# notifications are skipped. You do not need any of them for this exercise,
# and you are not expected to sign up for anything.
# ---------------------------------------------------------------------------

# AWS S3 image uploads
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_S3_PREFIX=
AWS_CLOUDFRONT_URL=

# Amazon SES
SES_FROM_EMAIL=
SES_TEAM_EMAIL=

# WATI (WhatsApp Business API)
WATI_API_URL=
WATI_API_TOKEN=
WATI_ENQUIRY_TEMPLATE=
WATI_TEAM_NUMBER=
WATI_WHATSAPP_NUMBER=

# Mailchimp, used by the newsletter subscribe CTA
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SERVER_PREFIX=

# Google Tag Manager container ID. Analytics is not loaded when unset.
NEXT_PUBLIC_GTM_ID=

# Google Places API, used for city suggestions. Cities are typed manually
# when unset.
GOOGLE_MAPS_API_KEY=
